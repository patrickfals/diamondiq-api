# DiamondIQ API — environment variables
#
# Copy this file to .env and fill in real values.
# Never commit a .env file containing real secrets.
# .env and .env.* are excluded by .gitignore.

# ---------------------------------------------------------------------------
# IBM watsonx Orchestrate
# ---------------------------------------------------------------------------

# IBM Cloud API key used to obtain IAM access tokens.
WO_API_KEY=your-ibm-cloud-api-key-here

# Base URL of the watsonx Orchestrate instance (no trailing slash).
# Example: https://us-south.ml.cloud.ibm.com
WO_INSTANCE_URL=https://your-orchestrate-instance-url-here

# Agent ID of the deployed DiamondIQ Analyst agent in Orchestrate.
WO_AGENT_ID=your-analyst-agent-id-here

# ---------------------------------------------------------------------------
# DiamondIQ test access
# ---------------------------------------------------------------------------

# Temporary access key for the /analyze-at-bat endpoint during IBM integration
# testing.  Compared using secrets.compare_digest (timing-safe).
DIAMONDIQ_TEST_KEY=your-test-key-here

# ---------------------------------------------------------------------------
# Snapshot signing (Stage 1)
# ---------------------------------------------------------------------------

# Secret used to sign and verify HMAC-SHA256 snapshot tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be set before POST /snapshot/redeem will function.
# Never share, log, or expose this value.
SNAPSHOT_SECRET=your-snapshot-secret-here
